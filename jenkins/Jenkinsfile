pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'sonalip1234'

        BACKEND_IMAGE  = "${DOCKERHUB_USER}/shopnow-backend"
        FRONTEND_IMAGE = "${DOCKERHUB_USER}/shopnow-frontend"

        IMAGE_TAG = '1.3'

        NAMESPACE = 'shopnow'
        HELM_CHART = './helm/shopnow'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    docker build \
                        -t ${BACKEND_IMAGE}:${IMAGE_TAG} \
                        ./backend
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                    docker build \
                        -t ${FRONTEND_IMAGE}:${IMAGE_TAG} \
                        ./frontend
                '''
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                sh '''
                    docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                    docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('Validate Helm Chart') {
            steps {
                sh '''
                    helm lint ${HELM_CHART}
                    helm template shopnow ${HELM_CHART} > /tmp/shopnow-rendered.yaml
                '''
            }
        }

        stage('Deploy with Helm') {
            steps {
                sh '''
                    helm upgrade --install shopnow ${HELM_CHART} \
                        --namespace ${NAMESPACE} \
                        --create-namespace
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    kubectl rollout status deployment/backend \
                        -n ${NAMESPACE} \
                        --timeout=120s

                    kubectl rollout status deployment/frontend-deployment \
                        -n ${NAMESPACE} \
                        --timeout=120s

                    kubectl get pods -n ${NAMESPACE}
                    kubectl get services -n ${NAMESPACE}
                '''
            }
        }
    }

    post {
        success {
            echo 'ShopNow deployment completed successfully!'
        }

        failure {
            echo 'ShopNow deployment failed. Check the Jenkins console log.'
        }

        always {
            sh 'docker logout || true'
        }
    }
}
