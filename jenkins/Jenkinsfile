
pipeline {
    agent any

    environment {
        AWS_REGION     = 'ap-south-1'
        ECR_REGISTRY   = '651863679098.dkr.ecr.ap-south-1.amazonaws.com'
        BACKEND_IMAGE  = '651863679098.dkr.ecr.ap-south-1.amazonaws.com/shopnow-backend'
        FRONTEND_IMAGE = '651863679098.dkr.ecr.ap-south-1.amazonaws.com/shopnow-frontend'
        EKS_CLUSTER    = 'shopnow-eks'
        NAMESPACE      = 'shopnow'
        HELM_CHART     = './helm/shopnow'
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh '''
                    set -eu
                    docker --version
                    aws --version
                    kubectl version --client
                    helm version
                '''
            }
        }

        stage('Build Images') {
            steps {
                sh '''
                    set -eu
                    docker build -t ${BACKEND_IMAGE}:${IMAGE_TAG} ./backend
                    docker build -t ${FRONTEND_IMAGE}:${IMAGE_TAG} ./frontend
                '''
            }
        }

        stage('Authenticate and Push to ECR') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-jenkins']
                ]) {
                    sh '''
                        set -eu
                        export AWS_DEFAULT_REGION="${AWS_REGION}"
                        aws sts get-caller-identity
                        aws ecr get-login-password --region "${AWS_REGION}" |
                          docker login --username AWS --password-stdin "${ECR_REGISTRY}"
                        docker push ${BACKEND_IMAGE}:${IMAGE_TAG}
                        docker push ${FRONTEND_IMAGE}:${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Validate Helm') {
            steps {
                sh '''
                    set -eu
                    helm lint ${HELM_CHART}
                    helm template shopnow ${HELM_CHART} \
                      --namespace ${NAMESPACE} \
                      --set backend.image.repository=${BACKEND_IMAGE} \
                      --set backend.image.tag=${IMAGE_TAG} \
                      --set frontend.image.repository=${FRONTEND_IMAGE} \
                      --set frontend.image.tag=${IMAGE_TAG} \
                      > /tmp/shopnow-rendered.yaml
                '''
            }
        }

        stage('Configure EKS Access') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-jenkins']
                ]) {
                    sh '''
                        set -eu
                        export AWS_DEFAULT_REGION="${AWS_REGION}"
                        aws eks update-kubeconfig \
                          --region "${AWS_REGION}" \
                          --name "${EKS_CLUSTER}"
                        kubectl get nodes
                    '''
                }
            }
        }

        stage('Deploy with Helm') {
            steps {
                sh '''
                    set -eu
                    helm upgrade --install shopnow ${HELM_CHART} \
                      --namespace ${NAMESPACE} \
                      --create-namespace \
                      --set backend.image.repository=${BACKEND_IMAGE} \
                      --set backend.image.tag=${IMAGE_TAG} \
                      --set frontend.image.repository=${FRONTEND_IMAGE} \
                      --set frontend.image.tag=${IMAGE_TAG}
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -eu
                    kubectl rollout status deployment/backend \
                      -n ${NAMESPACE} --timeout=180s
                    kubectl rollout status deployment/frontend-deployment \
                      -n ${NAMESPACE} --timeout=180s
                    kubectl get pods,services -n ${NAMESPACE}
                '''
            }
        }
    }

    post {
        success {
            echo 'ShopNow CI/CD pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check Console Output for the first failing stage.'
        }
        always {
            sh 'docker logout ${ECR_REGISTRY} || true'
        }
    }
}
